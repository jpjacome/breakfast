<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ONE HOST PER DOMAIN, or one person has two sessions.
    #
    # www.vamosdebreakfast.com served the app in its own right until
    # 2026-09-16, and SESSION_DOMAIN is null, so the session cookie is
    # host-only: signing in on the bare domain left the www copy signed out.
    # A client sat on www/portal sending the same question to Brandy ten times
    # and got a 401 every time, because the panel had been rendered while that
    # host still had a session and nothing on screen said it no longer did.
    #
    # Host-conditional on purpose, like the staging header below:
    # breakfast.drpixel.app shares this document root and must NOT be sent to
    # the client's domain.
    RewriteCond %{HTTP_HOST} ^www\.vamosdebreakfast\.com$ [NC]
    RewriteRule ^(.*)$ https://vamosdebreakfast.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Keep the staging domain out of search results. Both breakfast.drpixel.app and
# vamosdebreakfast.com share this document root, so the same pages would
# otherwise be indexed twice and compete with each other. Host-conditional, so
# the client's domain is untouched.
<IfModule mod_headers.c>
    SetEnvIf Host ^breakfast\.drpixel\.app$ STAGING
    Header set X-Robots-Tag "noindex, nofollow" env=STAGING
</IfModule>
