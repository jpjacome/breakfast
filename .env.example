APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the /contacto form delivers. Falls back to MAIL_FROM_ADDRESS if unset.
CONTACT_INBOX=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI / DeepSeek -----------------------------------------------------------
# Get a key at https://platform.deepseek.com. Never commit a real key.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URI=https://api.deepseek.com
DEEPSEEK_MODEL_CONTENT=deepseek-v4-pro
DEEPSEEK_MODEL_UTILITY=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.8
AI_MAX_TOKENS=8000
AI_TIMEOUT=300

# --- AI / OpenRouter ----------------------------------------------------------
# Set AI_PROVIDER=openrouter to route through it. The reason it exists is that
# DeepSeek is text-only and brandbooks arrive as PDFs — see config/ai.php.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URI=https://openrouter.ai/api/v1
OPENROUTER_MODEL_CONTENT=google/gemini-3.5-flash-lite
OPENROUTER_MODEL_UTILITY=google/gemini-3.5-flash-lite
OPENROUTER_TEMPERATURE=0.8

# Optional, and NOT the key above. Only a management key may read the account
# balance (/credits); the inference key gets a 403. Unset, the dashboard shows
# spend from our own ledger and omits the balance. Per-request cost is reported
# on every completion regardless, so it does not depend on this.
OPENROUTER_MANAGEMENT_KEY=
