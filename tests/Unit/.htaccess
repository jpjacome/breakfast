# ===========================================================================
# SECURITY - must stay above the Laravel rewrites and the WordPress section.
#
# orustravel.org is rooted at public_html, so it can see into every project
# folder. The app rewrites below are guarded by "RewriteCond %{REQUEST_FILENAME}
# !-f", which means they only fire for paths that do NOT exist on disk - so any
# real file was being served straight out. Verified before adding this:
#     /drpixel/innato/composer.json            -> 200
#     /drpixel/innato/storage/logs/laravel.log -> 200
# ===========================================================================

# Dotfiles: .env, .env.example, .git/*, .user.ini
# Matches the FILE name only, so .well-known/acme-challenge/<token> still
# resolves and AutoSSL keeps renewing.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Laravel internals. Scoped to the app folders so WordPress plugins that carry
# their own /vendor/ or /resources/ are untouched.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(drpixel/[^/]+|aurora-dev)/(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor)/ - [F,L]
    RewriteRule ^(drpixel/[^/]+|aurora-dev)/(composer\.(json|lock)|artisan|package(-lock)?\.json|vite\.config\.js|README\.md)$ - [F,L]
</IfModule>

# Main Apache Configuration

RewriteEngine On



# Force HTTPS

RewriteCond %{HTTPS} !=on

RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]



# CORS Headers

Header add Access-Control-Allow-Origin "*"

Header add Access-Control-Allow-Headers "origin, x-requested-with, content-type"

Header add Access-Control-Allow-Methods "PUT, GET, POST, DELETE, OPTIONS"



# Laravel App Routing - MUST COME BEFORE WORDPRESS RULES

<IfModule mod_rewrite.c>

    # Handle Laravel app at /drpixel/innato/

    RewriteCond %{REQUEST_URI} ^/drpixel/innato/?(.*)$

    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^drpixel/innato/?(.*)$ drpixel/innato/public/$1 [L]

    

    # Alternative: Direct index.php forwarding for /drpixel/innato/

    RewriteRule ^drpixel/innato/?$ drpixel/innato/public/index.php [L]

</IfModule>



# Laravel App Routing - MUST COME BEFORE WORDPRESS RULES

<IfModule mod_rewrite.c>

    # Handle Laravel app at /drpixel/passiflor/

    RewriteCond %{REQUEST_URI} ^/drpixel/passiflor/?(.*)$

    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^drpixel/passiflor/?(.*)$ drpixel/passiflor/public/$1 [L]

    

    # Alternative: Direct index.php forwarding for /drpixel/passiflor/

    RewriteRule ^drpixel/passiflor/?$ drpixel/passiflor/public/index.php [L]

</IfModule>

# Laravel App Routing - MUST COME BEFORE WORDPRESS RULES
<IfModule mod_rewrite.c>
    # Handle Laravel app at /drpixel/breakfast/
    RewriteCond %{REQUEST_URI} ^/drpixel/breakfast/?(.*)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^drpixel/breakfast/?(.*)$ drpixel/breakfast/public/$1 [L,QSA]

    # Bare /drpixel/breakfast or /drpixel/breakfast/
    RewriteRule ^drpixel/breakfast/?$ drpixel/breakfast/public/index.php [L,QSA]
</IfModule>

<IfModule mod_rewrite.c>
    # Forward all requests for /aurora-dev/* to the Laravel public folder
    RewriteCond %{REQUEST_URI} ^/aurora-dev/?(.*)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^aurora-dev/?(.*)$ aurora-dev/public/$1 [L,NC,QSA]

    # Direct index.php fallback when the URL is exactly /aurora-dev or /aurora-dev/
    RewriteRule ^aurora-dev/?$ aurora-dev/public/index.php [L,NC,QSA]
</IfModule>

# LSAPI Module Configuration

<IfModule lsapi_module>

#AddHandler application/x-httpd-alt-php74___lsphp .php .php5 .phtml

</IfModule>



# BEGIN W3TC Browser Cache

<IfModule mod_mime.c>

