# The FTP account deploys run through, used read-only by tools/production-log.sh
# so the production log can be read without opening cPanel.
#
# Copy this file to .env.deploy and fill it in. That copy is git-ignored and
# MUST NEVER BE UPLOADED — it is not portal/.env (local app config) and not
# portal/tests/.env (the env that IS uploaded and becomes production's own).
#
# These are the same credentials your FTP client already has saved.

FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Where storage/logs sits relative to the FTP account's landing directory. On
# iFastNet the account usually lands above the document root, so this is often
# something like "vamosdebreakfast.com/storage/logs" or "htdocs/storage/logs".
# Run `tools/production-log.sh --list` after setting it; if it 550s, the path is
# wrong and the error names what it tried.
FTP_LOG_DIR=storage/logs
